# Keep ModemManager away from the Skydimo adapter's CH340 bridge. Without this,
# ModemManager probes the port with AT commands for a few seconds after plug-in,
# which can collide with the driver's handshake.
# Install with:
#   sudo cp ~/.local/share/skydimo/99-skydimo.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", \
  ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1", TAG+="uaccess"
